# ---------------------------------------------------------------------------
# Zurl environment
#
# Copy to `.env.local` for development. Never commit a file containing real
# secrets — `.env.local` is gitignored.
# ---------------------------------------------------------------------------

# Database
#
# Production: a PostgreSQL connection string.
#   DATABASE_URL="postgresql://user:password@host:5432/zurl?sslmode=require"
#
# Local development without a Postgres server: PGlite (Postgres compiled to
# WebAssembly) runs in-process against a directory on disk. Same SQL, same
# migrations, no server to install.
#   DATABASE_URL="pglite://.data/zurl"
#
# Tests use `memory://`, which keeps the database entirely in RAM.
DATABASE_URL="pglite://.data/zurl"

# Maximum pooled connections when using a real PostgreSQL server.
# Keep this low on serverless platforms: many short-lived instances each hold
# their own pool, and the database connection limit is shared between them.
DATABASE_POOL_MAX="5"

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Absolute origin, no trailing slash. Used for canonical URLs, Open Graph tags,
# the sitemap and the short links shown in the UI. Getting this wrong means
# every canonical URL points at the wrong host.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ---------------------------------------------------------------------------
# Secrets — generate with: openssl rand -base64 32
# ---------------------------------------------------------------------------

# Salt used when hashing visitor IP addresses for rate limiting and abuse
# attribution. The raw IP is never stored; without a secret salt, a hash of the
# IPv4 space is trivially brute-forced and would become personal data again.
#
# Changing this resets anonymous rate-limit buckets and breaks the link between
# existing anonymous links and their creator.
IP_HASH_SECRET=""

# ---------------------------------------------------------------------------
# Observability
# ---------------------------------------------------------------------------

# One of: debug | info | warn | error
# Defaults to `info` in production and `debug` otherwise.
LOG_LEVEL="debug"
